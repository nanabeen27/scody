# Supabase 연결.
#
# `npm run db:*` 명령은 이 파일을 셸로 읽어들여요(`set -a && . ./.env`). 그래서 특수문자가 든
# 값은 반드시 작은따옴표로 감싸 주세요 — 감싸지 않으면 `$`·`#`이 셸에서 해석돼요.
#
# 공개 키(`EXPO_PUBLIC_*`)는 번들에 그대로 실려요. 실제 권한은 서버의 RLS 정책이 정해요.
# service_role 키는 절대 여기 넣지 않아요 — RLS를 통째로 우회해요.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# 아래 셋은 마이그레이션·seed를 올릴 때만 쓰고 앱 번들에는 들어가지 않아요.
# 토큰은 https://supabase.com/dashboard/account/tokens 에서 발급해요.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD='비밀번호를 따옴표로 감싸세요'

# OpenRouter API 키 (Scody AI). https://openrouter.ai/keys 에서 발급.
#
# **앱은 이 값을 읽지 않아요.** AI 호출은 Edge Function(`supabase/functions/ai-proxy`)이 하고,
# 키는 서버 환경변수에만 있어요. 이 줄은 `npm run ai:secret`이 그 서버 값을 설정할 때만 써요.
# 이름에 `EXPO_PUBLIC_`이 남아 있는 것은 예전 설정을 그대로 쓰는 사람을 위한 거예요.
OPENROUTER_API_KEY=sk-or-...

# 개발용 로그인(로그인 화면의 테스트 계정 패널). **기본값은 꺼짐이에요** — 두 값을 넣지 않은
# 빌드에는 이 경로가 아예 없고, 비밀번호 문자열도 번들에 들어가지 않아요(D-135).
#
# 실제 인증(카카오·휴대폰 OTP)이 붙기 전까지는 이것이 유일한 로그인이라 개발과 E2E에서는 켜 둬요.
# **운영 빌드에는 넣지 마세요** — 넣으면 seed 계정으로 누구나 들어올 수 있어요.
EXPO_PUBLIC_ENABLE_DEV_LOGIN=0
EXPO_PUBLIC_DEV_LOGIN_PASSWORD=<16자 이상 아무 값. seed 계정의 비밀번호가 된다>

# 데모 계정 6종(학생2·학부모2·학원2)의 비밀번호. 6자 이상. 값은 여기 적지 않는다(D-157).
# 이 여섯에는 admin 역할이 없고 데모학원 밖 데이터가 없어서 약한 값을 써도 된다(D-184).
# `EXPO_PUBLIC_` 접두어가 없다 — 데모 진입은 사람이 타이핑하므로 클라이언트가 이 값을 모른다.
DEMO_LOGIN_PASSWORD=<6자 이상. 데모 계정 6종의 비밀번호>
