{
  "name": "scody",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "web:serve": "npx serve dist --single --listen 8081",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:e2e": "playwright test",
    "web:preview": "expo export -p web --output-dir dist && npx serve dist -s -l 8081",
    "motion:wasm": "cp node_modules/@lottiefiles/dotlottie-web/dist/dotlottie-player.wasm public/",
    "db:push": "set -a && . ./.env && set +a && supabase db push",
    "db:seed": "tsx scripts/gen-seed.ts && tsx scripts/run-sql.ts supabase/seed.sql",
    "db:types": "set -a && . ./.env && set +a && supabase gen types typescript --linked > src/lib/database.types.ts",
    "db:verify": "npm run db:seed && tsx scripts/verify-rls.ts",
    "ai:secret": "set -a && . ./.env && set +a && supabase secrets set OPENROUTER_API_KEY=\"$OPENROUTER_API_KEY\"",
    "ai:deploy": "set -a && . ./.env && set +a && supabase functions deploy ai-proxy",
    "ai:verify": "tsx scripts/verify-ai.ts"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@lottiefiles/dotlottie-react": "0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "^57.0.8",
    "expo-constants": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.21.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "pg": "^8.23.0",
    "serve": "^14.2.6",
    "supabase": "^2.114.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
