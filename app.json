{
  "expo": {
    "name": "스코디",
    "slug": "scody",
    "scheme": "scody",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "ko",
      "name": "Scody - 가장 효율적인 학습 플랫폼"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
